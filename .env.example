# ============================================================
# ScholarX — Environment Variables Template
# Copy this to .env and fill in your actual API keys
# NEVER commit .env to git!
# ============================================================

# === Gemini API Keys (rotate on failure) ===
GEMINI_API_KEY_1=your_gemini_key_here
GEMINI_API_KEY_2=your_gemini_key_here
GEMINI_API_KEY_3=your_gemini_key_here
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.0-flash

# === Groq API Keys (rotate on failure) ===
GROQ_API_KEY_1=your_groq_key_here
GROQ_API_KEY_2=your_groq_key_here
GROQ_API_KEY_3=your_groq_key_here
GROQ_API_KEY_4=your_groq_key_here
GROQ_MODEL=gpt-oss-120b

# === Tavily Search API Keys (rotate on failure) ===
TAVILY_API_KEY_1=your_tavily_key_here
TAVILY_API_KEY_2=your_tavily_key_here
TAVILY_API_KEY_3=your_tavily_key_here
TAVILY_API_KEY_4=your_tavily_key_here
TAVILY_API_KEY_5=your_tavily_key_here

# === Firecrawl API Keys (rotate on failure) ===
FIRECRAWL_API_KEY_1=your_firecrawl_key_here
FIRECRAWL_API_KEY_2=your_firecrawl_key_here
FIRECRAWL_API_KEY_3=your_firecrawl_key_here

# === Jina Reader API Key ===
JINA_API_KEY=your_jina_key_here

# === Local Database (Docker) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scholarx
POSTGRES_USER=scholarx
POSTGRES_PASSWORD=scholarx_local

REDIS_HOST=localhost
REDIS_PORT=6379

CHROMADB_HOST=localhost
CHROMADB_PORT=8100

SESSION_DB_PATH=./data/scholarx_sessions.db
